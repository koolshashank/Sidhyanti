# Copy this file to .env and fill in real values locally. .env itself is
# gitignored -- never commit real credentials (same convention as
# config/db.php / api/config/jwt_config.php on the PHP side).

DB_HOST=168.220.248.128
DB_NAME=SidhyantiCRM
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false

# A long random string, independent of the PHP API's JWT_SECRET -- this is
# a separate backend with its own tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_HOURS=8

PORT=4000
CORS_ORIGIN=http://localhost:5173
